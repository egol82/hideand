; Hide & Smashing — Phase 19 seven-map finish and bounded decoration batches; historical entries remain.
; Open using the standard (non-.NET) Godot editor.
config_version=5

[application]
config/name="Hide & Smashing"
run/main_scene="res://scenes/phase19.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Draw a toy weapon. Hide from friends. Smash your way out. Offline Phase19: shared toy-world materials, themed finishes and spatially batched decoration."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/size/resizable=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.10, 0.14, 0.18, 1)

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=18.0

[editor_plugins]
enabled=PackedStringArray("res://addons/toy_studio/plugin.cfg", "res://addons/manor_bake15/plugin.cfg")
